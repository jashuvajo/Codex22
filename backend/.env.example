APP_ENV=development
LOG_LEVEL=INFO

TRADING_MODE=simulator
SCANNER_INTERVAL_SECONDS=1
AI_THRESHOLD=70
STALE_FEED_SECONDS=4

UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_MARKET_AUTHORIZE_ENDPOINT=/feed/market-data-feed/authorize
UPSTOX_PROFILE_ENDPOINT=/user/profile

NIFTY_INSTRUMENT_KEY=NSE_INDEX|Nifty 50
SENSEX_INSTRUMENT_KEY=BSE_INDEX|SENSEX

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nexusquant
REDIS_URL=redis://redis:6379/0

DAILY_CAPITAL=300000
CAPITAL_ALLOCATION_PCT=10
MAX_EXPOSURE_PCT=40
MAX_DAILY_DRAWDOWN_PCT=5
MAX_SLIPPAGE_BPS=20
MAX_LATENCY_MS=250
COOLDOWN_AFTER_LOSSES=3
REQUIRE_LIVE_UPSTOX_CONNECTION=true
